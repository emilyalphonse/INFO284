   ],
   "source": [
    "import re\n",
    "\n",
    "# --- COPY original data ---\n",
    "df_clean = df.copy()\n",
    "\n",
    "print(\"Original number of reviews:\", len(df_clean))\n",
    "\n",
    "\n",
    "# --- 1. Remove reviews with very long words ---\n",
    "#This filter removes reviews containing unusually long single words, which are often spam or noise, improving data quality for text analysis.\n",
    "df_clean = df_clean[\n",
    "    ~df_clean[\"review_text\"].str.split().apply(\n",
    "        lambda words: any(len(word) > 15 for word in words)\n",
    "    )\n",
    "]\n",
    "\n",
    "print(\"After removing long words:\", len(df_clean))\n",
    "\n",
    "# Regex pattern for 3+ repeated consecutive words\n",
    "# --- 2. Remove repeating words (spam) ---\n",
    "pattern = r'\\b(\\w+)\\b(?=\\s+\\1\\b\\s+\\1\\b)'\n",
    "\n",
    "mask = df_clean[\"review_text\"].str.contains(pattern, case=False, regex=True, na=False)\n",
    "df_clean = df_clean[~mask]\n",
    "\n",
    "print(\"After removing repeated words:\", len(df_clean))\n",
    "\n",
    "\n",
    "# --- 3. Basic text cleaning --- TAR IKKE VEKK NOEN\n",
    "def clean_text(text):\n",
    "    text = text.lower()\n",
    "    text = re.sub(r\"\\d+\", \"\", text)\n",
    "    text = re.sub(r\"[^\\w\\s]\", \"\", text)\n",
    "    text = re.sub(r\"\\s+\", \" \", text).strip()\n",
    "    return text\n",
    "\n",
    "df_clean[\"review_text\"] = df_clean[\"review_text\"].apply(clean_text)\n",
    "\n",
    "print(\"After basic text cleaning:\", len(df_clean))\n",
    "\n",
    "\n",
    "# --- 4. Remove empty reviews ---\n",
    "df_clean = df_clean[df_clean[\"review_text\"].str.strip() != \"\"]\n",
    "\n",
    "print(\"After text cleaning:\", len(df_clean))\n",
    "\n",
    "\n",
    "# --- FINAL SUMMARY ---\n",
    "print(\"\\n--- CLEANING SUMMARY ---\")\n",
    "print(\"Original:\", len(df))\n",
    "print(\"Final:\", len(df_clean))\n",
    "print(\"Total removed:\", len(df) - len(df_clean))\n",
    "\n",
    "df = df_clean\n"
   ]
